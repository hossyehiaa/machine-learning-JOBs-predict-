# ============================================================
# CareerAI Studio Monorepo Environment Variables Example
# Copy to .env.local (webapp) or configure in Vercel / Render / Fly.io / HF Spaces
# NEVER commit real API keys or tokens.
# ============================================================

# --- Next.js Frontend (Server-Side API Proxy Routes) ---
FITNET_API_URL=http://127.0.0.1:8000
PATHNET_API_URL=http://127.0.0.1:8001
FITNET_API_KEY=
PATHNET_API_KEY=

# --- FastAPI Backends (CORS & Security Hardening) ---
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.vercel.app
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$
RATE_LIMIT_PER_MINUTE=60
